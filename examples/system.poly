system Light
    Off,
    On

system Counter
    Count[n: Int] if (n >= 0) {
        Increment -> Count[n + 1],
        Decrement if (n > 0) -> Count[n - 1]
    }

defer Indicator: Light -> Counter
    Off -> Count[0] {
        Increment -> Off
    },
    On -> Count[1] {
        Inrement -> On,
        Decrement -> Off
    }
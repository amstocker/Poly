state Counter
    Count[n: Int] if (n >= 0) {
        Increment -> Count[n + 1],
        Decrement if (n > 0) -> Count[n - 1]
    }

# An interface can have a single anonymous state
interface Button
    { Press }

# Most mimimal syntax...
#   1.  We don't need to say that `Count[_]` maps to the single
#       anonymous state because that can be inferred.
#   2.  We don't need to say the source of the transition because we know
#       the source state being mapped, so we can just say the new state.
#   3.  A defer can be anonymous as well.
defer Counter -> Button { Press -> Count[10] }

# Another defer
defer Counter -> Button { Press -> Increment }

# This one should be invalid, because the Decrement action is
# not available in all states!  The Engine should infer this
# and raise an error during parsing.
# 
# defer Counter -> Button { Press -> Decrement }

# Instead we should do:
interface StatefulButton
    Enabled { Press },
    Disabled

defer DecrementButton: Counter -> StatefulButton
    Count[0] -> Disabled,
    Count[n] if (n > 0) -> Enabled {
        Press -> Decrement
    }
